#include <iostream>
#include <vector>
using namespace std;
void print_vec(vector<int> v) {
    for (int i = 0;i < v.size();i++) {       
        cout << v[i] << " ";
    }
    cout << endl;

}
int main()

{
    vector<int> v;
    while (true) {
        int button;
        cin >> button;
        if (button == 0) {
            break;
        }
        else {
            v.push_back(button);
        }
    }
    int a, b;
    if (v.size() > 0) {
        print_vec(v);
    }
    else {
        cout << "Void in vector";
    }
    
}
